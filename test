SYNTAX_VERSION 2
LOGFILE "MyApp DATA threshold with server"
DESCRIPTION "监控 Windows 日志，当 Cnt > 200000 告警，并包含 server"
# LOGPATH 可留空，因为预处理脚本会输出日志
CHSET UTF8
FROM_LAST_POS
POLLING_INTERVAL 60s

PREPROC
    FILE "powershell.exe"
    ARGS "-ExecutionPolicy Bypass -File \"D:\\monitor\\flatten-log.ps1\""
END

MSGCONDITIONS
    DESCRIPTION "DATA 超阈值"
    CONDITION
        TEXT "^(<*project>)\\s\\|\\s(<*cnt>)\\s\\|\\sserver=(<*server>)$"
        SET project "<project>"
        SET cnt "<cnt>"
        SET server "<server>"
        COMPARE cnt GT 200000
        SEVERITY Critical
        SET TEXT "Project <project> 超阈值：<cnt>（阈值 200000）@<server>"
END



