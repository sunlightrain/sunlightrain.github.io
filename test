$ntpServers = @("10.68.121.7","10.68.121.8")

Foreach($Host in Get-VMHost){
    Write-Host "Configuring NTP on $Host..."
    # 清理旧的 NTP 配置
    Get-VMHostNtpServer -VMHost $Host | Remove-VMHostNtpServer -Confirm:$false

    # 添加新的 NTP 服务器
    foreach ($ntp in $ntpServers){
        Add-VMHostNtpServer -NtpServer $ntp -VMHost $Host
    }

    # 启动并设置 ntpd 服务
    $ntpd = Get-VMHostService -VMHost $Host | Where-Object {$_.Key -eq "ntpd"}
    Start-VMHostService -HostService $ntpd
    Set-VMHostService -HostService $ntpd -Policy "on" -Confirm:$false

    # 验证 NTP 配置
    $esxcli = Get-EsxCli -VMHost $Host -V2
    $time = $esxcli.system.time.get.Invoke()
    $ntpStatus = $esxcli.system.ntp.get.Invoke()
    Write-Host "Host: $Host | Time: $($time.Date) $($time.Hour):$($time.Minute):$($time.Second) | NTP Enabled: $($ntpStatus.Enabled)"
}


